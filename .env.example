DATABASE_URL=sqlite:///./logged.db
UPLOAD_DIR=./uploads
# Opcional: pasta temporária dos uploads de importação (fora do /uploads público).
# IMPORT_DIR=./imports
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Fallback de instância (opcional). Cada usuário pode configurar as próprias
# chaves dentro do app (Integrações). Não são embutidas na imagem.
# TMDB — crie uma chave em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB / Twitch OAuth (create app at https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Credenciais de app para os sincronizadores de biblioteca.
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
# MAL_CLIENT_ID=

# Desliga o agendador de sincronização (útil em testes).
# LIBRARY_SYNC_SCHEDULER_ENABLED=true
