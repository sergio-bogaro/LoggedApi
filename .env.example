DATABASE_URL=sqlite:///./logged.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Fallback de instância (opcional). Cada usuário pode configurar as próprias
# chaves dentro do app (Integrações). Não são embutidas na imagem.
# TMDB — crie uma chave em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB / Twitch OAuth (create app at https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret
